// Cloudflare deploy for the static frontend: `npx craco build && npx wrangler deploy`
{
  "name": "alinazelinska",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "alinazelinska.com", "custom_domain": true },
    { "pattern": "www.alinazelinska.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./build",
    // Client-side routes (/about, /services/…) all serve index.html
    "not_found_handling": "single-page-application"
  }
}
